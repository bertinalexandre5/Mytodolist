# Réglages du serveur TodoList : modèle du fichier .env
#
# Pour changer un réglage :
#   1. copiez ce fichier sous le nom .env, dans ce même dossier serveur/ ;
#   2. modifiez les valeurs voulues (et supprimez les lignes que vous ne changez pas) ;
#   3. relancez le serveur : le fichier .env n'est lu qu'au démarrage.
#
# Les lignes qui commencent par # sont des commentaires. Un réglage absent du fichier garde
# sa valeur par défaut, celle indiquée ci-dessous. Une variable d'environnement du même nom
# l'emporte sur le fichier .env.
#
# Le fichier .env est ignoré par Git : chacun peut avoir le sien.

# Port d'écoute du serveur.
# Si vous le changez, changez aussi "target" dans le proxy.conf.json de l'étape Angular lancée.
PORT=8080

# Fichier de la base SQLite, créé au premier lancement. Chemin relatif au dossier serveur/.
DB_PATH=todo.db

# true : au premier lancement (quand le fichier de la base n'existe pas encore), le serveur
# crée quelques listes d'exemple pour les routes de test ; ces mêmes listes sont les « valeurs
# de départ » renvoyées par GET /api/sync. false : base vide, et aucune valeur de départ.
DEMO_DATA=true

# Pause, en millisecondes, avant chaque réponse. Elle simule un réseau lent, pour voir
# l'application attendre (essayez 1500). 0 : pas de pause.
DELAY_MS=0
