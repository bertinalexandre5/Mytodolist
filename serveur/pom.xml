<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fichier de construction Maven : il décrit le projet Java, ses dépendances (bibliothèques
  téléchargées automatiquement) et la façon de le lancer.
  Commande utile, depuis ce dossier : ./mvnw compile exec:java (ou .\mvnw.cmd sous Windows).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>todo</groupId>
  <artifactId>todo-serveur</artifactId>
  <version>1.0.0</version>
  <name>Serveur TodoList</name>

  <properties>
    <!-- Le code utilise Java 21 : il faut un JDK 21 ou plus récent. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Pilote JDBC pour lire et écrire la base SQLite (un simple fichier). -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
    </dependency>
    <!-- Jackson convertit les objets Java en JSON, et inversement. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.2.3</version>
    </dependency>
    <!-- JUnit, uniquement pour les tests (./mvnw test). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- Autorise le pilote SQLite à charger sa bibliothèque native, sans avertissement.
               Même réglage que .mvn/jvm.config, qui sert au lancement du serveur. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <!-- « exec:java » lance la méthode main de la classe indiquée ici. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>todo.TodoServer</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
